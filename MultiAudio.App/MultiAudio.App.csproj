<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- The app is Audix; the project folder keeps its original MultiAudio name. -->
    <AssemblyName>Audix</AssemblyName>
    <Product>Audix</Product>
    <AssemblyTitle>Audix</AssemblyTitle>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <Company>Audix</Company>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- shortcut: SystemAware is crisp on the primary monitor, bitmap-stretched on a second monitor with a different scale.
         Upgrade to PerMonitorV2 by rebuilding the UI (and fonts) in a DpiChanged handler. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>