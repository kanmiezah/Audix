<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Exe stays MultiAudio.exe so existing shortcuts keep working; everything users read says Audio Router. -->
    <AssemblyName>MultiAudio</AssemblyName>
    <Product>Audio Router</Product>
    <AssemblyTitle>Audio Router</AssemblyTitle>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <Company>Audio Router</Company>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- shortcut: SystemAware is crisp on the primary monitor, bitmap-stretched on a second monitor with a different scale.
         Upgrade to PerMonitorV2 by rebuilding the UI (and fonts) in a DpiChanged handler. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>